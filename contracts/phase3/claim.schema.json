{
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "writ-source/1",
          "default": "writ-source/1",
          "title": "Contract Version",
          "type": "string"
        },
        "uri": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "committed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Committed At"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        }
      },
      "required": [
        "uri",
        "revision"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "recorded_at": {
      "title": "Recorded At",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid From"
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    },
    "contract_version": {
      "const": "writ-claim/1",
      "default": "writ-claim/1",
      "title": "Contract Version",
      "type": "string"
    },
    "project": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Project",
      "type": "string"
    },
    "claim_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Claim Id",
      "type": "string"
    },
    "topic": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Topic",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "kind": {
      "enum": [
        "model_assertion",
        "repository_assertion"
      ],
      "title": "Kind",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    }
  },
  "required": [
    "recorded_at",
    "project",
    "claim_id",
    "topic",
    "title",
    "text",
    "content_digest",
    "source",
    "kind"
  ],
  "title": "Claim",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Runtime additionally validates UTC calendar instants, digests, identity and current revision semantics; JSON shape alone is insufficient."
}
